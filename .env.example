# ==============================================================================
# AI Football Arena — Environment Configuration Guide (.env.example)
# راهنمای جامع متغیرهای محیطی و تنظیمات فیزیکی بازی
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. تنظیمات اصلی جنگو (Django Core Settings)
# ------------------------------------------------------------------------------
# کلید امنیتی جنگو (در محیط عملیاتی حتماً یک مقدار تصادفی و امن قرار دهید)
DJANGO_SECRET_KEY=dev-only-change-me

# حالت اشکال‌زدایی (در محیط پروداکشن حتماً False باشد)
DJANGO_DEBUG=False

# هاست‌ها و دامنه‌های مجاز (با کاما از هم جدا شوند)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# آدرس‌های معتبر پروتکل امن HTTPS برای اعتبارسنجی CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=

# فعال‌سازی هدرهای پشت پروکسی (مانند Nginx یا Caddy)
DJANGO_BEHIND_PROXY=False

# مسیر سفارشی فایل پایگاه داده SQLite (اختیاری)
# DJANGO_DB_PATH=/app/data/db.sqlite3

# حساب مدیر ارشد (Superuser) که هنگام اجرای کانتینر به‌صورت خودکار ساخته/به‌روزرسانی می‌شود.
# اگر تنظیم نشوند، هیچ حسابی ساخته نمی‌شود. رمز عبور را در محیط عملیاتی حتماً تغییر دهید.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-please
DJANGO_SUPERUSER_EMAIL=admin@example.com


# ------------------------------------------------------------------------------
# 2. تنظیمات هوش مصنوعی و مدل زبانی (AI & LLM Configuration)
# ------------------------------------------------------------------------------
# کلید API پلتفرم OrcaRouter برای اتصال به مدل DeepSeek V4 Flash
ORCAROUTER_API_KEY=sk-orca-YOUR-API-KEY-HERE

# شناسه مدل هوش مصنوعی
ORCAROUTER_MODEL=deepseek/deepseek-v4-flash-free

# آدرس پایه API
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1


# ------------------------------------------------------------------------------
# 3. ابعاد و هندسه زمین بازی (Playground Geometry)
# ------------------------------------------------------------------------------
# عرض کل زمین بازی بر حسب پیکسل
GAME_PLAYGROUND_WIDTH=1280.0

# ارتفاع کل تصویر زمین بازی بر حسب پیکسل
GAME_PLAYGROUND_HEIGHT=720.0

# موقعیت عمودی خط سطح زمین بازی (Y coordinate)
GAME_GROUND_Y=610.0

# عمق فرورفتگی دروازه‌ها به داخل دیواره‌ها
GAME_GOAL_DEPTH=122.0

# ارتفاع دهانه و تیرک بالایی دروازه از خط زمین
GAME_GOAL_HEIGHT=205.0

# شعاع لوله فلزی تیرک بالایی دروازه
GAME_GOAL_POST_RADIUS=7.0


# ------------------------------------------------------------------------------
# 4. فیزیک و مشخصات توپ (Ball Physics & Elasticity)
# ------------------------------------------------------------------------------
# شعاع دایره توپ فوتبال (اندازه توپ)
GAME_BALL_RADIUS=23.0

# شتاب گرانش زمین وارد بر توپ (gravity coefficient)
GAME_GRAVITY=1700.0

# سقف حداکثر سرعت مجاز توپ (px/s)
GAME_BALL_MAX_SPEED=1450.0

# ضریب کشسانی و جهش توپ از روی زمین (0.0 تا 1.0)
GAME_FLOOR_BOUNCE=0.58

# ضریب اصطکاک لغزشی توپ با سطح چمن زمین بازی
GAME_FLOOR_FRICTION=0.980

# ضریب مقاومت و اصطکاک هوا برای توپ (Air Drag)
GAME_BALL_AIR_DRAG=0.999

# ضریب کشسانی و بازگشت برخورد توپ با دیوارهای کناری
GAME_BALL_WALL_BOUNCE=0.84

# ضریب کشسانی و بازگشت برخورد توپ با سقف
GAME_BALL_CEILING_BOUNCE=0.82

# ضریب کشسانی و پرتاب توپ در برخورد با سر بازیکن (Head Restitution)
GAME_BALL_HEAD_RESTITUTION=0.78

# ضریب کشسانی برخورد توپ با بالاتنه و شکم بازیکن (Body Restitution)
GAME_BALL_BODY_RESTITUTION=0.46

# ضریب تکانه و جرم موثر توپ در هنگام برخورد با بازیکن (Ball Weight/Impulse Scale)
GAME_BALL_IMPULSE_SCALE=0.05

# حداکثر ایمپالس ناشی از تماس بدنی با توپ
GAME_BALL_CONTACT_IMPULSE_CAP=850.0

# حداقل سرعت حرکت توپ قبل از سکون و توقف کامل روی زمین
GAME_BALL_SLEEP_SPEED=8.0


# ------------------------------------------------------------------------------
# 5. ابعاد و دینامیک حرکتی بازیکنان (Player Physics & Dynamics)
# ------------------------------------------------------------------------------
# عرض بازیکن (پیکسل)
GAME_PLAYER_WIDTH=66.0

# ارتفاع بازیکن (پیکسل)
GAME_PLAYER_HEIGHT=84.0

# حداکثر سرعت دویدن بازیکن روی زمین (px/s)
GAME_PLAYER_SPEED=385.0

# سرعت اولیه پرش عمودی بازیکن به هوا (px/s)
GAME_PLAYER_JUMP_SPEED=790.0

# شتاب گرانش وارد بر بازیکن (پایین کشیدن در هوا)
GAME_PLAYER_GRAVITY=2050.0

# شتاب افزایش سرعت دویدن روی زمین
GAME_PLAYER_ACCELERATION=2800.0

# شتاب ترمز و ایستادن بازیکن روی زمین
GAME_PLAYER_DECELERATION=3400.0

# شتاب کنترل و هدایت بازیکن در حین پرواز در هوا
GAME_PLAYER_AIR_ACCELERATION=1300.0

# شتاب کاهش سرعت در هوا
GAME_PLAYER_AIR_DECELERATION=90.0

# زمان وقفه بین دو پرش پیاپی بازیکن (ثانیه)
GAME_JUMP_COOLDOWN=0.38

# شعاع سر دایره‌ای بازیکن
GAME_PLAYER_HEAD_RADIUS=34.0

# مرکز عمودی سر نسبت به بالای بازیکن
GAME_PLAYER_HEAD_CENTER_Y=18.0

# فرورفتگی عرضی بدنه زیر سر
GAME_PLAYER_BODY_INSET_X=10.0

# شروع ارتفاع بدنه زیر سر
GAME_PLAYER_BODY_TOP_OFFSET=36.0

# ضریب الاستیسیته و بازگشت در برخورد دو بازیکن با هم
GAME_PLAYER_BUMP_RESTITUTION=0.32

# فاصله جداسازی بازیکنان پس از برخورد
GAME_PLAYER_BUMP_SEPARATION=1.5

# نسبت انتقال سرعت دویدن بازیکن به توپ در هنگام تنه زدن
GAME_PLAYER_CONTACT_VELOCITY_TRANSFER=0.18


# ------------------------------------------------------------------------------
# 6. مکانیک و قدرت ضربات و شوت‌ها (Kick Parameters)
# ------------------------------------------------------------------------------
# حداکثر فاصله مجاز مرکز بازیکن تا توپ برای امکان ضربه زدن (شعاع شوت)
GAME_KICK_REACH=126.0

# مولفه قدرت افقی شوت زمینی (KICK_LOW)
GAME_KICK_LOW_X=850.0

# مولفه قدرت عمودی شوت زمینی (KICK_LOW)
GAME_KICK_LOW_Y=-170.0

# زمان بازیابی و ریکاوری شوت زمینی (ثانیه)
GAME_KICK_LOW_COOLDOWN=0.40

# مولفه قدرت افقی شوت قوسی و هوایی (KICK_HIGH)
GAME_KICK_HIGH_X=760.0

# مولفه قدرت عمودی شوت قوسی و هوایی (KICK_HIGH)
GAME_KICK_HIGH_Y=-620.0

# زمان بازیابی و ریکاوری شوت هوایی (ثانیه)
GAME_KICK_HIGH_COOLDOWN=0.46

# مولفه قدرت افقی ضربه دفع اضطراری (KICK_CLEAR)
GAME_KICK_CLEAR_X=1000.0

# مولفه قدرت عمودی ضربه دفع اضطراری (KICK_CLEAR)
GAME_KICK_CLEAR_Y=-360.0

# زمان بازیابی و ریکاوری ضربه دفع (ثانیه)
GAME_KICK_CLEAR_COOLDOWN=0.52

# نسبت حفظ سرعت قبلی توپ در لحظه ضربه خوردن
GAME_KICK_KEEP_BALL_VELOCITY=0.38

# ضریب انتقال سرعت دویدن بازیکن به شتاب شوت
GAME_KICK_PLAYER_VELOCITY_TRANSFER=0.52

# حداقل فاصله برای فعال شدن فرمان حرکت به سمت هدف
GAME_MOVE_DEADZONE=6.0


# ------------------------------------------------------------------------------
# 7. مکانیزم‌های ضد قفل‌شدگی و نبرد همزمان (Anti-Lock & Contested Physics)
# ------------------------------------------------------------------------------
# پرتاب توپ به بالا در ضربه سر هنگام دویدن سریع
GAME_RUNNING_TOUCH_LIFT=135.0

# پرتاب عمودی توپ هنگام تحت فشار قرار گرفتن بین دو بازیکن
GAME_CONTESTED_BALL_POP_Y=640.0

# نسبت حفظ سرعت افقی توپ در درگیری همزمان
GAME_CONTESTED_BALL_HORIZONTAL_KEEP=0.65

# پرتاب بازیکنان به عقب در درگیری همزمان (Recoil)
GAME_CONTESTED_PLAYER_RECOIL=95.0

# پرتاب عمودی توپ هنگام شوت همزمان دو بازیکن
GAME_CONTESTED_KICK_POP_Y=820.0

# نسبت حفظ سرعت افقی در شوت همزمان
GAME_CONTESTED_KICK_HORIZONTAL_KEEP=0.55

# پس‌زدن بازیکنان در شوت همزمان
GAME_CONTESTED_KICK_RECOIL=135.0

# حداقل سرعت افقی پرتاب توپ در درگیری‌های سنگین
GAME_CONTESTED_ESCAPE_X=175.0

# آستانه سرعت توقف کامل توپ (تشخیص گیر کردن توپ)
GAME_STALL_SPEED_THRESHOLD=45.0

# زمان سکون توپ قبل از پرتاب ملایم throw-in به مرکز زمین (ثانیه)
GAME_STALL_POP_AFTER=2.5

# زمان سکون توپ قبل از ریست کامل و Kickoff مجدد (ثانیه)
GAME_STALL_KICKOFF_AFTER=5.0

# سرعت افقی پرتاب ملایم ضد توقف
GAME_STALL_POP_VX=220.0

# سرعت عمودی پرتاب ملایم ضد توقف
GAME_STALL_POP_VY=640.0


# ------------------------------------------------------------------------------
# 8. تنظیمات مسابقه، فریم‌ها و زمان‌بندی (Match Timing & Precision)
# ------------------------------------------------------------------------------
# مدت زمان کل هر مسابقه فوتبال (ثانیه)
GAME_MATCH_TIME=60.0

# مدت زمان فریز و مکث پس از به ثمر رسیدن گل و قبل از شروع مجدد (ثانیه)
GAME_KICKOFF_FREEZE=0.90

# نرخ فریم اجرای محاسبات فیزیک بر حسب هرتز
GAME_PHYSICS_FPS=60

# نرخ فریم ذخیره و ارسال فریم‌ها به کلاینت
GAME_RECORD_FPS=20

# تعداد زیرگام‌های انتگرال‌گیری فیزیک در هر فریم
GAME_PHYSICS_SUBSTEPS=2
