+
+DEEPSEEK_API_URL = "https://api.deepseek.com/chat/completions"
+DEEPSEEK_MODEL = os.getenv("DEEPSEEK_MODEL", "deepseek-v4-flash")
+
+
+class LLMConfigurationError(RuntimeError):
+    """The server is missing required LLM configuration."""
+
+
+class LLMServiceError(RuntimeError):
+    """The external LLM service failed or returned an unusable result."""
+
+
+def _system_prompt() -> str:
+    sensor_lines = "\n".join(f"- {name}: {kind}" for name, kind in SENSORS.items())
+    action_lines = "\n".join(f"- {name}" for name in ACTIONS)
+    operators = ", ".join(OPERATORS)
+
+    return f"""
+You are the strategy compiler for a simple 1v1 football game for school students.
+The student's input is usually Persian.
+Understand the student's EXACT intended logic and convert it to JSON.
+
+FAIRNESS RULES:
+1. Do NOT make the student's strategy smarter, safer, or more competitive.
+2. Do NOT add defensive/offensive/timing/prediction ideas they did not express.
+3. A weak but executable strategy is valid.
+4. Never invent sensors, actions, or operators.
+5. If an important phrase is vague and cannot be represented with the vocabulary,
+   return valid=false and explain the ambiguity in simple Persian.
+6. Preserve the student's intended priority/order.
+7. Do not invent arbitrary numeric thresholds.
+8. Output JSON only. No markdown.
+
+ALLOWED SENSORS:
+{sensor_lines}
+
+ALLOWED OPERATORS:
+{operators}
+
+ALLOWED ACTIONS:
+{action_lines}
+
+Condition JSON:
+{{
+  "left": "sensor_name",
+  "operator": "<|<=|>|>=|==|!=",
+  "rightType": "value|sensor",
+  "right": 123 or true or "another_sensor"
+}}
+
+Strategy JSON:
+{{
+  "label": "My Bot",
+  "rules": [
+    {{
+      "priority": 1,
+      "conditions": [
+        {{
+          "left": "can_kick",
+          "operator": "==",
+          "rightType": "value",
+          "right": true
+        }}
+      ],
+      "action": "KICK_LOW"
+    }}
+  ],
+  "default_action": "IDLE"
+}}
+
+Your complete JSON response must use this envelope:
+{{
+  "valid": true,
+  "feedback": [],
+  "strategy": {{ ... }}
+}}
+
+If the strategy is ambiguous/unexecutable:
+{{
+  "valid": false,
+  "feedback": ["یک توضیح کوتاه و کاربردی به فارسی"],
+  "strategy": null
+}}
+
+DIRECT INTERPRETATIONS:
+- "برو سمت توپ / دنبال توپ برو" -> MOVE_TO_BALL
+- "برگرد دفاع / سمت دروازه خودی برو" -> MOVE_TO_GOAL
+- "برو وسط / مرکز زمین" -> MOVE_TO_CENTER
+- "بپر" -> JUMP
+- "شوت زمینی" -> KICK_LOW
+- "شوت هوایی / چیپ" -> KICK_HIGH
+- "دفع کن / دور کن" -> KICK_CLEAR
+- "صبر کن / هیچ کار نکن" -> IDLE
+- "من نزدیکترم" -> distance_to_ball < opponent_distance_to_ball
+- "حریف نزدیکتره" -> opponent_distance_to_ball < distance_to_ball
+- "توپ نیمه ماست" -> ball_in_own_half == true
+- "توپ نیمه حریفه" -> ball_in_enemy_half == true
+- "می‌توانم شوت کنم" -> can_kick == true
+- "عقبم" -> score_difference < 0
+- "جلو هستم" -> score_difference > 0
+
+Example:
+Student:
+"اگر بتونم شوت کنم شوت زمینی بزن. اگر حریف از من به توپ نزدیک‌تر بود برگرد دفاع.
+اگر من نزدیک‌تر بودم برو سمت توپ."
+
+JSON:
+{{
+  "valid": true,
+  "feedback": [],
+  "strategy": {{
+    "label": "My Bot",
+    "rules": [
+      {{
+        "priority": 1,
+        "conditions": [
+          {{"left":"can_kick","operator":"==","rightType":"value","right":true}}
+        ],
+        "action": "KICK_LOW"
+      }},
+      {{
+        "priority": 2,
+        "conditions": [
+          {{"left":"opponent_distance_to_ball","operator":"<","rightType":"sensor","right":"distance_to_ball"}}
+        ],
+        "action": "MOVE_TO_GOAL"
+      }},
+      {{
+        "priority": 3,
+        "conditions": [
+          {{"left":"distance_to_ball","operator":"<","rightType":"sensor","right":"opponent_distance_to_ball"}}
+        ],
+        "action": "MOVE_TO_BALL"
+      }}
+    ],
+    "default_action": "IDLE"
+  }}
+}}
+""".strip()
+
+
+def _request_deepseek(text: str) -> dict:
+    api_key = os.getenv("DEEPSEEK_API_KEY")
+    if not api_key:
+        raise LLMConfigurationError(
+            "DEEPSEEK_API_KEY تنظیم نشده است. کلید را فقط روی سرور به‌صورت متغیر محیطی قرار بده."
+        )
+
+    payload = {
+        "model": DEEPSEEK_MODEL,
+        "messages": [
+            {"role": "system", "content": _system_prompt()},
+            {
+                "role": "user",
+                "content": "استراتژی دانش‌آموز را دقیقاً به JSON تبدیل کن:\n\n" + text,
+            },
+        ],
+        "thinking": {"type": "disabled"},
+        "response_format": {"type": "json_object"},
+        "temperature": 0.1,
+        "max_tokens": 2500,
+    }
+
+    request = urllib.request.Request(
+        DEEPSEEK_API_URL,
+        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
+        headers={
+            "Authorization": f"Bearer {api_key}",
+            "Content-Type": "application/json",
+            "Accept": "application/json",
+        },
+        method="POST",
+    )
+
+    try:
+        with urllib.request.urlopen(request, timeout=45) as response:
+            raw = response.read().decode("utf-8")
+    except urllib.error.HTTPError as exc:
+        detail = exc.read().decode("utf-8", errors="replace")
+        raise LLMServiceError(
+            f"DeepSeek API error ({exc.code}): {detail[:500]}"
+        ) from exc
+    except urllib.error.URLError as exc:
+        raise LLMServiceError(f"خطا در اتصال به DeepSeek: {exc.reason}") from exc
+
+    try:
+        return json.loads(raw)
+    except json.JSONDecodeError as exc:
+        raise LLMServiceError("پاسخ DeepSeek JSON معتبر نبود.") from exc
+
 
 def compile_persian_strategy(text: str) -> dict:
-    raise NotImplementedError("LLM integration will be added in the next step.")
+    text = (text or "").strip()
+    if not text:
+        raise StrategyValidationError("متن استراتژی خالی است.")
+    if len(text) > 5000:
+        raise StrategyValidationError("متن استراتژی بیش از حد طولانی است.")
+
+    response = _request_deepseek(text)
+
+    try:
+        content = response["choices"][0]["message"]["content"]
+    except (KeyError, IndexError, TypeError) as exc:
+        raise LLMServiceError("ساختار پاسخ DeepSeek قابل خواندن نبود.") from exc
+
+    if not content:
+        raise LLMServiceError("DeepSeek پاسخ خالی برگرداند. دوباره تلاش کن.")
+
+    try:
+        compiled = json.loads(content)
+    except json.JSONDecodeError as exc:
+        raise LLMServiceError("محتوای DeepSeek JSON معتبر نبود.") from exc
+
+    if not isinstance(compiled, dict) or "valid" not in compiled:
+        raise LLMServiceError("خروجی LLM ساختار مورد انتظار را ندارد.")
+
+    feedback = compiled.get("feedback")
+    if not isinstance(feedback, list):
+        feedback = []
+
+    usage = response.get("usage") or {}
+    usage_summary = {
+        "prompt_tokens": usage.get("prompt_tokens", 0),
+        "completion_tokens": usage.get("completion_tokens", 0),
+        "total_tokens": usage.get("total_tokens", 0),
+        "cache_hit_tokens": usage.get("prompt_cache_hit_tokens", 0),
+        "cache_miss_tokens": usage.get("prompt_cache_miss_tokens", 0),
+    }
+
+    if compiled.get("valid") is not True:
+        return {
+            "valid": False,
+            "feedback": feedback or [
+                "این استراتژی هنوز به شرط‌های قابل اندازه‌گیری تبدیل نمی‌شود."
+            ],
+            "strategy": None,
+            "model": response.get("model", DEEPSEEK_MODEL),
+            "usage": usage_summary,
+        }
+
+    strategy = compiled.get("strategy")
+    try:
+        validate_strategy(strategy)
+    except StrategyValidationError as exc:
+        raise LLMServiceError(
+            f"LLM یک Strategy نامعتبر ساخت و Validator آن را رد کرد: {exc}"
+        ) from exc
+
+    strategy["label"] = "My Bot"
+
+    return {
+        "valid": True,
+        "feedback": feedback,
+        "strategy": strategy,
+        "model": response.get("model", DEEPSEEK_MODEL),
+        "usage": usage_summary,
+    }
